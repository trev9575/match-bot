DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=1447782573052002535
GUILD_ID=1221566123108208780

# CS2 server (overrides config.json; keep the password here, not in config.json)
CS2_SERVER_IP=
CS2_SERVER_PORT=27015
CS2_SERVER_PASSWORD=

# ---------------- CS2 stats / leaderboard ----------------
# Channel where a scorecard is posted after every match (right-click the channel > Copy Channel ID)
STATS_CHANNEL_ID=
# Any long random string. The bot and the stats service both read it from this file.
# Make one with:  openssl rand -hex 24
STATS_API_KEY=
# MatchZy's demo folder inside the AMP instance (check the instance name in AMP)
MATCHZY_DEMO_DIR=/home/amp/.ampdata/instances/Counter-Strike201/counter-strike2/730/game/csgo/MatchZy
# Port the leaderboard website listens on
STATS_PORT=8080
# The address people open in their browser. Used for the links in Discord and the one-click Join Server button.
# e.g. http://203.0.113.5:8080 or https://stats.yourdomain.com  (leave empty to hide the links)
STATS_PUBLIC_URL=

# Optional: the server's LAN IP, shown on the join page for people on the server's home network
CS2_LAN_ADDRESS=
# Optional, rarely needed: lets /link accept custom steamcommunity.com/id/name links (most people pick their name)
STEAM_API_KEY=

# --- Elo / ranks ---
# Matches before a rank shows (CS:GO needed 10 wins), and days idle before it's hidden (0 = never)
PLACEMENT_MATCHES=5
RANK_EXPIRE_DAYS=30

# --- tuning (defaults are fine) ---
# Matches needed to be ranked (fewer = faded on the site, hidden in /leaderboard)
LEADERBOARD_MIN_MATCHES=2
# Which game modes count (comma-separated). wingman = scrimcomp2v2
ALLOWED_MODES=competitive
# Rounds needed to win: 13 for MR12, 9 for MR8 short matches
WIN_ROUNDS=13
# Skip demos shorter than this (warmups, abandoned games)
MIN_ROUNDS=10
# Skip games where a team had fewer regulars than this
MIN_TEAM_SIZE=4
# How often to check for new demos, and how long a demo must stop growing before it's read
POLL_SECONDS=20
STABLE_SECONDS=45
# Post scorecards for demos that were already in the folder on first start
BACKFILL_ANNOUNCE=false
